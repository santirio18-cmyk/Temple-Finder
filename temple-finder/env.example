# Temple Finder Configuration
# Copy this file to .env.local and add your API keys

# Supabase (optional — for future backend features)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps JavaScript API key — used for:
# - Map display (Maps JavaScript API)
# - Nearby Hindu temples (Places API — enable "Places API" on the same key)
# Restrict the key by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Optional AI keys (if you use those features)
VITE_OPENAI_API_KEY=
VITE_PERPLEXITY_API_KEY=
VITE_GEMINI_API_KEY=
